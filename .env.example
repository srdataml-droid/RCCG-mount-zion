# Supabase project URL and keys. The service role key is server-side only and
# must never be exposed through Vite client variables.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# The one Supabase Auth user allowed to use /admin, taken from the user's ID
# in Authentication → Users. Required: every admin route returns 503 until
# this is set. It is an ID rather than an email so that an administrator
# changing their own email in the Account section never locks themselves out.
ADMIN_USER_ID="YOUR_SUPABASE_AUTH_USER_UUID"

# Public browser values used only by the /admin Supabase Auth sign-in flow.
# These are read at BUILD time, so they must be present when `npm run build`
# runs on the host, not only at runtime.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# PostHog browser analytics. Optional and also read at build time — leave both
# unset to omit the analytics library from the bundle entirely. These are
# public project values, not a secret.
VITE_POSTHOG_KEY="YOUR_POSTHOG_PROJECT_API_KEY"
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# The public address of the deployed site, with no trailing slash. Drives
# robots.txt, sitemap.xml, and the canonical/og:url tags. Set it to the host's
# own URL (for example https://rccg-mount-zion.onrender.com) until a real
# domain exists. Leave it unset locally — the tags are then simply omitted.
SITE_URL="https://YOUR_SITE_URL"

# Serve the built site from dist/ instead of running the Vite dev middleware.
# Set this on the production host.
NODE_ENV="production"

# Most hosts inject PORT themselves; the server falls back to 3000 locally.
# PORT="3000"
