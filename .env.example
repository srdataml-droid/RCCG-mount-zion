# Supabase project URL and keys. The service role key is server-side only and
# must never be exposed through Vite client variables.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Public browser values used only by the /admin Supabase Auth sign-in flow.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# PostHog browser analytics. These are public project values, not a secret.
VITE_POSTHOG_KEY="YOUR_POSTHOG_PROJECT_API_KEY"
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
